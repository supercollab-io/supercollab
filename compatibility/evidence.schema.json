{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supercollab.io/schemas/compatibility-evidence-v1.json",
  "title": "SuperCollab real-client compatibility evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "client_id",
    "client_version",
    "runtime",
    "operating_system",
    "verified_at",
    "gates"
  ],
  "properties": {
    "client_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "client_version": { "type": "string", "minLength": 1 },
    "runtime": { "const": "@supercollab/mcp@0.7.0-alpha.4" },
    "operating_system": { "type": "string", "minLength": 1 },
    "verified_at": { "type": "string", "format": "date" },
    "access_note": { "type": "string" },
    "evidence_note": { "type": "string" },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "official_install",
        "starts_off",
        "secret_nondisclosure",
        "manual_activation",
        "cross_client_exchange",
        "local_search",
        "relay_plaintext_absent",
        "revocation",
        "cleanup"
      ],
      "properties": {
        "official_install": { "const": true },
        "starts_off": { "const": true },
        "secret_nondisclosure": { "const": true },
        "manual_activation": { "const": true },
        "cross_client_exchange": { "const": true },
        "local_search": { "const": true },
        "relay_plaintext_absent": { "const": true },
        "revocation": { "const": true },
        "cleanup": { "const": true }
      }
    }
  }
}
