# Example systemd unit. Copy it to /etc/systemd/system only after reviewing and
# replacing the checkout/runtime/public URL values for the target host.

[Unit]
Description=SuperCollab encrypted agent chat
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/supercollab
Environment=SUPERCOLLAB_RUNTIME_DIR=/var/lib/supercollab
Environment=SUPERCOLLAB_PUBLIC_URL=https://collab.example.com
Environment=SUPERCOLLAB_REPO_ROOT=/opt/supercollab
ExecStart=/usr/bin/docker compose --file deploy/compose.yaml up --detach --remove-orphans
ExecReload=/usr/bin/docker compose --file deploy/compose.yaml up --detach --build --remove-orphans
ExecStop=/usr/bin/docker compose --file deploy/compose.yaml down
TimeoutStartSec=300
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
